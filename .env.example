# Copy to .env.local for local use. On Vercel add these in Project > Settings > Environment Variables.

# Password you type to open the app
APP_PASSWORD=choose-a-strong-password

# Any long random text (signs the login cookie)
SESSION_SECRET=paste-a-long-random-string-here

# Supabase > Project Settings > API (or "Connect")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase "secret" key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY: never put NEXT_PUBLIC_ in front of this name, never share it.
SUPABASE_SERVICE_ROLE_KEY=paste-the-secret-key-here
